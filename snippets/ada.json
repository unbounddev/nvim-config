{
  "procedure_def": {
    "prefix": "procedure",
    "body": [
      "procedure ${1:Name} is",
      "begin",
      "\t${0:null;}",
      "end ${1:Name};"
    ]
  },
  "function_def": {
    "prefix": "function",
    "body": [
      "function ${1:Name} return ${2:type} is",
      "begin",
      "\t$0",
      "end ${1:Name};"
    ]
  },
  "with": {
    "prefix": "with",
    "body": [
      "with ${1:Package_Name};"
    ]
  },
  "use": {
    "prefix": "use",
    "body": [
      "use ${1:Package_Name};"
    ]
  },
  "package_spec": {
    "prefix": "package",
    "body": [
      "package ${1:Package_Name} is",
      "\t$0",
      "end ${1:Package_Name};"
    ]
  }
}
